# Base URL of the AuthCore backend API.
#
# The backend mounts its router at /api/v1 (backend/src/app.ts) and defaults to
# port 8000 (backend/src/config/env.ts), so include the /api/v1 suffix here.
#
# This must match the backend's FRONTEND_URL/CORS origin pairing: the backend
# runs CORS with credentials against a single fixed origin, and auth cookies are
# only sent if the two agree.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
